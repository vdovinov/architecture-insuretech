        <mxCell id="Qo2aUMTiF9W-19NxFvms-94" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;" value="Горизонтальное масштабирование и мультизональное развертывание.&lt;br&gt;Позволяет увеличивать количество реплик,&amp;nbsp;обеспечивает отказоустойчивость." vertex="1">
          <mxGeometry height="170" width="160" x="70" y="190" as="geometry" />
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-61" edge="1" parent="1" source="Qo2aUMTiF9W-19NxFvms-23" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.504;entryY=0;entryDx=0;entryDy=0;startArrow=classic;startFill=1;strokeColor=#009900;entryPerimeter=0;exitX=0.499;exitY=0.999;exitDx=0;exitDy=0;exitPerimeter=0;strokeWidth=2;" target="Qo2aUMTiF9W-19NxFvms-43">
