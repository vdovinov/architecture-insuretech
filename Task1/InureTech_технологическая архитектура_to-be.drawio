            <mxPoint x="500" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-97" connectable="0" parent="Qo2aUMTiF9W-19NxFvms-61" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Health Check (Liveness/Readiness)" vertex="1">
          <mxGeometry relative="1" x="0.1231" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-98" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;position2=1;" value="Используется балансировщик (ALB). Он направляет трафик веб-приложения (HTTPS) на поды фронтенда, а API-трафик (HTTPS) — на поды бэкенда. Балансировщик проверяет liveness и readiness пробы на подах." vertex="1">
          <mxGeometry height="184" width="155.5" x="279" y="40" as="geometry" />
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-99" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;" value="&lt;div&gt;Failover-стратегия: Active-Active.&lt;/div&gt;&lt;div&gt;Трафик распределяется между всеми тремя зонами одновременно через балансировщик.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="160" x="650" y="190" as="geometry" />
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-101" parent="1" style="text;whiteSpace=wrap;" value="Синхронная репликация гарантирует, что данные, записанные в мастер, будут продублированы минимум в одну реплику до подтверждения клиенту. Это важно для RPO=15 мин., так как при потере мастера данные не пропадут." vertex="1">
          <mxGeometry height="120" width="270" x="30" y="880" as="geometry" />
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-102" parent="1" style="text;whiteSpace=wrap;" value="Шардирование не требуется на данном этапе. Объем данных всего 50 ГБ, что нормально  обслуживается одним кластером PostgreSQL. Шардирование добавит лишнюю сложность без необходимости." vertex="1">
          <mxGeometry height="120" width="270" x="337.25" y="890" as="geometry" />
        </mxCell>
        <mxCell id="Qo2aUMTiF9W-19NxFvms-103" parent="1" style="text;whiteSpace=wrap;" value="Резервное копирование: Автоматический ежедневный  (бэкап) всего кластера, хранящиеся отдельно от кластера в объектном хранилище. WAL-архивирование в реальном времени позволяет восстановиться на любой момент времени, что и обеспечивает RPO." vertex="1">
          <mxGeometry height="80" width="210" x="625" y="880" as="geometry" />
        </mxCell>
